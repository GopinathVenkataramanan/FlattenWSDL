import sys
import requests
from lxml import etree
from urllib.parse import urljoin

# XML namespace constants
XSD_NS = "http://www.w3.org/2001/XMLSchema"
WSDL_NS = "http://schemas.xmlsoap.org/wsdl/"
NSMAP = {'xsd': XSD_NS, 'wsdl': WSDL_NS}

def download_and_flatten_wsdl(wsdl_url, output_file='flattened.wsdl'):
    downloaded = {}

    def download_recursive(url):
        if url in downloaded:
            return downloaded[url]

        response = requests.get(url)
        response.raise_for_status()
        content = response.content
        tree = etree.XML(content)

        # Handle XSD imports/includes
        for element in tree.xpath('//xsd:import | //xsd:include', namespaces=NSMAP):
            location = element.get("schemaLocation")
            if not location:
                continue
            full_url = urljoin(url, location)
            child_tree = download_recursive(full_url)

            parent = element.getparent()
            parent.remove(element)

            imported_root = child_tree.getroot()
            # Insert each child element of imported schema into current schema
            for child in imported_root:
                parent.append(child)

        # Handle WSDL imports (e.g. <wsdl:import location="..." namespace="..."/>)
        for element in tree.xpath('//wsdl:import', namespaces=NSMAP):
            location = element.get("location")
            if not location:
                continue
            full_url = urljoin(url, location)
            child_tree = download_recursive(full_url)

            parent = element.getparent()
            parent.remove(element)

            # Merge all top-level wsdl definitions (types, messages, portTypes, etc.)
            for child in child_tree.getroot():
                parent.append(child)

        downloaded[url] = etree.ElementTree(tree)
        return downloaded[url]

    root_tree = download_recursive(wsdl_url)
    root_tree.write(output_file, pretty_print=True, xml_declaration=True, encoding='utf-8')
    print(f'✅ Flattened WSDL saved to: {output_file}')

# Entry point
if __name__ == '__main__':
    if len(sys.argv) < 2:
        print("Usage: python flatten_wsdl.py <WSDL_URL> [output_file]")
        sys.exit(1)

    wsdl_url = sys.argv[1]
    output_file = sys.argv[2] if len(sys.argv) > 2 else 'flattened.wsdl'
    download_and_flatten_wsdl(wsdl_url, output_file)
